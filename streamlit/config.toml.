[theme]
# Bright green accent (buttons, active tab, sliders, checkboxes, upload box)
primaryColor = "#00D26E"
# Chrome-grey page background (the .stApp CSS gradient in app.py adds the
# metallic shine on top of this flat fallback)
backgroundColor = "#C7C9CE"
# White panels / input boxes / sidebar
secondaryBackgroundColor = "#FFFFFF"
# Royal blue text throughout
textColor = "#1B2FBE"
font = "sans serif"

[server]
# Reject uploads over 20MB at the server level, matching the Gemini API's
# own inline-file limit, so oversized files fail fast with a clear message
# instead of a confusing API error later.
maxUploadSize = 20
